<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Flutter uses the same light palette in both device appearance modes. -->
    <color name="studydesk_launch_surface">#FBF4E1</color>
    <style name="StudyDeskWindow" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/studydesk_launch_surface</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="LaunchTheme" parent="@style/StudyDeskWindow">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- The Flutter embedding swaps to this theme before the first frame. -->
    <style name="NormalTheme" parent="@style/StudyDeskWindow" />
</resources>
